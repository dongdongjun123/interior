# ==========================================================
# 환경변수 템플릿 — 복사해서 .env 로 사용
#   cp .env.example .env  (그리고 값 채우기)
# ==========================================================

# --- Gemini (model1 평면도 / model2 무드) ---
# Google AI Studio에서 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# (선택) 특징 추출 — 저토큰·저비용 (model2/run_gemini_features.py, 06_gemini_features)
GEMINI_FEATURE_MODEL=gemini-2.5-flash-lite

# (선택) 분석용 모델 — 인테리어 사진에서 공간 구조 추출 (flash 권장, 정확도↑)
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash

# (선택) 평면도 이미지 생성 모델
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# (선택) 공간추론 thinking 예산(토큰). 클수록 정확·느림. 0=끄기, -1=동적
GEMINI_THINKING_BUDGET=4096

# (선택) 자기교정 패스: 1이면 layout을 사진과 재대조해 수정(API 1회 추가). 0=끄기
GEMINI_LAYOUT_REFINE=1

# --- 네이버 쇼핑 검색 API (backend/app.py 가구 추천) ---
# https://developers.naver.com/apps 에서 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- Florence-2 가구 탐지 오케스트레이션 (orchestration/) ---
# on/off 스위치: 아래 경로를 채우면 Florence 켜짐, 비우면 꺼짐(근거 없이 Gemini만).
#
# Florence-2는 transformers==4.49.0 을 요구해 메인 venv와 충돌한다.
# 그래서 별도 환경(room-object-detection/README.md의 conda 'roomdet')에서 돌리고,
# 오케스트레이터가 아래 python 실행파일을 subprocess로 호출한다.
#   예) Windows conda: C:/Users/이름/anaconda3/envs/roomdet/python.exe
#       Linux/conda:   /home/이름/anaconda3/envs/roomdet/bin/python
#
# GPU 권장: RTX(VRAM 4GB+)면 충분. CPU로도 동작하지만 이미지 1장에 수 분 걸린다.
# ROOMDET_REQUIRE_GPU=1 로 두면 GPU 없을 때 탐지를 건너뛰어(CPU 저속 실행 방지),
# GPU 있는 곳에서만 자동으로 켜지게 할 수 있다. 0/빈값이면 CPU도 허용.
ROOMDET_PYTHON=
ROOMDET_REQUIRE_GPU=1
