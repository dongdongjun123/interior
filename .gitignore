# Python
__pycache__/
*.py[cod]
.venv/
venv/
venv-linux/
venv-win/
.ipynb_checkpoints/

# 환경변수
.env

# 생성 산출물 (재생성 가능)
output/floorplans/*
!output/floorplans/.gitkeep
data/gemini_features.json
data/gemini_embeddings.npy
data/gemini_image_paths.json
data/previews/umap_gemini.png
data/clip_image_embeddings.npy
data/clip_image_paths.json

# 검색 캐시 (자동 생성)
data/prompt_translation_cache.json

# 업로드/생성 이미지 (프론트 런타임 산출물)
frontend/static/uploads/*
frontend/static/generated/*
!frontend/static/uploads/.gitkeep
!frontend/static/generated/.gitkeep

# 무드 원본 데이터셋 — 이미 커밋된 스냅샷 고정.
# 로컬에서 사진을 추가/삭제해도 git이 자동으로 추적하지 않는다
# (기존에 커밋된 파일은 별도 git rm/add 전까진 그대로 유지됨).
images/final/*

# YOLO 가중치 (최초 실행 시 자동 다운로드)
*.pt

# Freepik 원본 벡터(재배포 금지 — 심볼만 추출해 사용)
loft-plan.zip
*.ai
*.eps
